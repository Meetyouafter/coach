{
  "name": "zal-beg",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "node --env-file-if-exists=.env --env-file-if-exists=.env.local scripts/dev.mjs",
    "build": "vite build",
    "vercel-build": "node scripts/check-env.mjs && npm run db:migrate && npm run build",
