# Neon: Dashboard → Connect → connection string (pooled).
# Keep these values server-side; do not use a VITE_ prefix.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/neondb?sslmode=require
# Stable server-only secret, at least 16 characters. Not a user password.
# Generate: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
AUTH_SECRET=
